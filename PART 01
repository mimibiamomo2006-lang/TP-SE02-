#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main(void) {
    printf("[Parent] PID=%d, PPID=%d\n", getpid(), getppid());
    pid_t pid = fork();

    if (pid < 0) {
        perror("fork failed");
        return 1;
    } else if (pid == 0) {
        printf("[Child ] PID=%d, Parent=%d\n", getpid(), getppid());
        fflush(stdout);
        execlp("ls", "ls", "-l", (char *)NULL);
        perror("exec failed");   /* only on error */
        _exit(1);
    } else {
        printf("[Parent] Created child %d, waiting...\n", pid);
        int status;
        waitpid(pid, &status, 0);
        if (WIFEXITED(status))
            printf("[Parent] Child exited, status=%d\n", WEXITSTATUS(status));
    }
    return 0;
}
